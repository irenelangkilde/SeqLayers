{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(dig *)",
      "Bash(nslookup *)",
      "Bash(sysctl vm.swapusage)",
      "Bash(sysctl -n hw.*)",
      "Bash(vm_stat)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Hero.aiff"
          }
        ]
      }
    ]
  }
}
